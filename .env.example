# Copy to .env.local for local development, and add the same keys in Vercel > Project > Settings > Environment Variables.

# --- Database (Neon) ---------------------------------------------------------
# Production: the pooled Neon connection string.
# Local: run `npm run db:local`, then use postgresql://postgres@127.0.0.1:5433/postgres?sslmode=disable
DATABASE_URL=

# --- Admin login (Better Auth) ----------------------------------------------
# Long random string: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public site address, no trailing slash (e.g. https://thegatheringcof.org). Locally: http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# --- File storage (S3-compatible bucket: Neon Object Storage, AWS S3, Cloudflare R2...) ---
# Leave S3_BUCKET empty locally to store uploads in .data/storage.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# "true" for most non-AWS providers (defaults to true when S3_ENDPOINT is set)
S3_FORCE_PATH_STYLE=

# --- Email (Amazon SES) ----------------------------------------------------
# Enquiries are always saved in the admin inbox; these settings also email them to the team.
SES_REGION=eu-west-2
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
# A verified SES sender, e.g. "The Gathering <noreply@thegatheringcof.org>"
SES_FROM=
# Where enquiries are delivered (comma-separated for several)
ENQUIRY_TO=thegatheringcof@gmail.com

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
