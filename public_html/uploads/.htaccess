# Uploaded files are data only — nothing in here may ever run as code.
Options -Indexes -ExecCGI
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .pl .py .cgi .sh
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
<FilesMatch "(?i)\.(php\d?|phtml|phar|pl|py|cgi|sh|html?|svg|js|htaccess)$">
  Require all denied
</FilesMatch>
<FilesMatch "(?i)\.(jpe?g|png|gif|webp|avif|pdf)$">
  Require all granted
</FilesMatch>
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  <FilesMatch "(?i)\.pdf$">
    Header set Content-Disposition "inline"
  </FilesMatch>
</IfModule>
